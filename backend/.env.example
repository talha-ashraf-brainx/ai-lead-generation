# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Set to "false" once real API credentials below are wired up (per SRS Section 5)
SEED_MODE=true

# Postgres (local for dev; managed provider — Supabase/Neon/Railway — before deploy)
DATABASE_URL=postgresql://localhost:5432/emberline_dev

# Redis (BullMQ) — added in Phase 5 (defaults to redis://localhost:6379 if unset)
REDIS_URL=

# Auth — added in Phase 1
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# The single account-owner user (per SRS: no self-serve signup). Used by `npm run db:seed`.
ACCOUNT_OWNER_EMAIL=owner@emberline.dev
ACCOUNT_OWNER_PASSWORD=changeme123
ACCOUNT_OWNER_NAME=Account Owner

# Lead enrichment — added in Phase 3
APOLLO_API_KEY=
HUNTER_API_KEY=

# AI email generation — added in Phase 4. Goes through OpenRouter (openai-compatible
# API), not OpenAI directly — get a key at https://openrouter.ai/keys. Model names are
# OpenRouter's provider-prefixed slugs, e.g. "openai/gpt-4o-mini", "anthropic/claude-3.5-sonnet".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Email sending — added in Phase 5
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=outreach@emberline.dev
SENDGRID_FROM_NAME=Emberline Outreach
# SendGrid Event Webhook verification key (Settings > Mail Settings > Event Webhook > Signed Event Webhook
# Requests). Leave blank in dev — the webhook endpoint will skip signature verification and log a warning.
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# Reply detection — added in Phase 6 (SendGrid Inbound Parse). Requires an MX record on
# INBOUND_REPLY_DOMAIN pointed at SendGrid, and an Inbound Parse setting whose destination
# URL is .../api/webhooks/sendgrid-inbound?token=<INBOUND_PARSE_SECRET> — see dev-required.md.
INBOUND_REPLY_DOMAIN=reply.emberline.dev
INBOUND_PARSE_SECRET=

# Notifications — added in Phase 7. Slack webhook URL is NOT an env var — it's
# entered via Settings and stored in the notification_settings table (one per user
# already implied to be a single account owner). SMTP is for internal alert emails
# ("a lead replied"), separate from SendGrid which is outreach-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@emberline.dev
SMTP_FROM_NAME=Emberline Alerts

# Settings — added in Phase 9. Encrypts stored API keys / SMTP password at rest
# (AES-256-GCM). Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=
