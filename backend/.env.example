# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Dev/observability only — every provider integration always uses the real keys below
# regardless of this flag. Controls: search result volume (5 vs 25), follow-up timing
# (15s/30s vs 3day/7day), whether password-reset exposes a dev token, and whether the
# in-app debug log (Topbar > Debug) captures anything.
DEBUG=true

# Postgres (local for dev; managed provider — Supabase/Neon/Railway — before deploy)
DATABASE_URL=postgresql://localhost:5432/emberline_dev

# Redis (BullMQ) — added in Phase 5 (defaults to redis://localhost:6379 if unset)
REDIS_URL=

# Auth — added in Phase 1
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# The single account-owner user (per SRS: no self-serve signup). Used by `npm run db:seed`.
ACCOUNT_OWNER_EMAIL=owner@emberline.dev
ACCOUNT_OWNER_PASSWORD=changeme123
ACCOUNT_OWNER_NAME=Account Owner

# Lead enrichment — added in Phase 3
APOLLO_API_KEY=
HUNTER_API_KEY=

# AI email generation — added in Phase 4. Goes through OpenRouter (openai-compatible
# API), not OpenAI directly — get a key at https://openrouter.ai/keys. Model names are
# OpenRouter's provider-prefixed slugs, e.g. "openai/gpt-4o-mini", "anthropic/claude-3.5-sonnet".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Email sending — added in Phase 5. No verified domain yet, so RESEND_FROM_EMAIL stays
# Resend's shared onboarding@resend.dev sender (see dev-required.md for the sandbox
# recipient restrictions this implies). Swap once a domain is verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Emberline Outreach
# Resend webhook signing secrets (Dashboard > Webhooks > select endpoint). Leave blank in
# dev — the webhook endpoints will skip signature verification and log a warning.
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_WEBHOOK_SECRET=

# Debug-mode send redirect (DEBUG=true only). Resend refuses real lead addresses until a
# sending domain is verified ("Domain is not verified"), so every send is redirected here
# instead — which also means a dev machine can't email a real lead. `delivered@resend.dev`
# is Resend's always-deliverable sink but you can't read those. To actually receive and
# read the emails, set this to the email address you signed up to Resend with.
DEBUG_EMAIL_REDIRECT_TO=delivered@resend.dev

# Reply detection — added in Phase 6 (Resend inbound email). Requires a receiving domain
# set up for INBOUND_REPLY_DOMAIN (Dashboard > Receiving) and a webhook subscribed to
# email.received pointing at .../api/webhooks/resend-inbound — see dev-required.md.
# Leave blank until that domain is real: a made-up value puts an unresolvable Reply-To
# header on every outbound send. Blank = no Reply-To sent, reply detection off.
INBOUND_REPLY_DOMAIN=

# Notifications — added in Phase 7. Slack webhook URL is NOT an env var — it's
# entered via Settings and stored in the notification_settings table (one per user
# already implied to be a single account owner). SMTP is for internal alert emails
# ("a lead replied"), separate from Resend which is outreach-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@emberline.dev
SMTP_FROM_NAME=Emberline Alerts

# Settings — added in Phase 9. Encrypts stored API keys / SMTP password at rest
# (AES-256-GCM). Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=
